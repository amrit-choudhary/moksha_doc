// Bind groups match PSOWebGPU (pso_webgpu.h).
@group(0) @binding(0) var<uniform> passData: CBPerPassUI;
@group(0) @binding(1) var<uniform> atlasProps: TextureAtlasProperties;
@group(1) @binding(0) var tex: texture_2d<f32>;
@group(1) @binding(1) var texSampler: sampler;
@group(2) @binding(0) var<storage, read> instanceBuffer: array<InstanceData>;

@vertex
fn VS(input: VertexIn, @builtin(instance_index) instanceID: u32) -> VertexOut {
    var output: VertexOut;

    let instanceData = instanceBuffer[instanceID];

    output.position = GetUIPosition(instanceData.modelMatrix * vec4f(input.position, 0.0, 1.0), passData.screenDimension);
    let flippedUV = vec2f(input.uv.x, 1.0 - input.uv.y);
    output.uv = GetAtlasUV(flippedUV, instanceData.atlasIndex, atlasProps, instanceData.flags);
    output.color = instanceData.color;

    return output;
}

@fragment
fn PS(input: VertexOut) -> @location(0) vec4f {
    let texColor = textureSample(tex, texSampler, input.uv);
    if (texColor.a < 0.1) {
        discard;
    }

    return texColor * input.color;
}
// UI text shader for instanced rendering. WGSL port of ui_text.hlsl: keep them in sync.

// The WGSL version of game side structs used for rendering: the counterpart of structs.hlsl and structs.metal. Layouts
// match the C++ classes (rendering/shared/texture.h, sprite_renderer.h, text_renderer.h, shader_constants.h), but declare
// only the fields shaders read: a buffer may be bigger than its struct, and uniform arrays have a 16-byte stride, so the
// C++ padding arrays can't be mirrored as arrays.

// Per Pass Constant Buffer. The lights follow the two matrices in the buffer.
struct CBPerPass {
    viewMatrix: mat4x4f,
    projectionMatrix: mat4x4f,
}

// Per Pass Constant Buffer for UI Text and UI Sprite
struct CBPerPassUI {
    screenDimension: u32,  // Packed: high 16 bits width, low 16 bits height.
}

// Texture Atlas Properties
struct TextureAtlasProperties {
    tileSizeX: u32,
    tileSizeY: u32,
    padding: u32,
    numTextures: u32,
    numTilesX: u32,
    numTilesY: u32,
