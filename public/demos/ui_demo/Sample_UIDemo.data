[window]
width=1200
height=900
vsync=1

[time]
fixedStepFPS=60

[net]
serverIP=127.0.0.1
serverPort=9310
contentServerIP=127.0.0.1
contentServerPort=9311
// Simple sprite shader for non instanced rendering. WGSL port of sprite_atlas.hlsl: keep them in sync.

// The WGSL version of game side structs used for rendering: the counterpart of structs.hlsl and structs.metal. Layouts
// match the C++ classes (rendering/shared/texture.h, sprite_renderer.h, text_renderer.h, shader_constants.h), but declare
// only the fields shaders read: a buffer may be bigger than its struct, and uniform arrays have a 16-byte stride, so the
// C++ padding arrays can't be mirrored as arrays.

// Per Pass Constant Buffer. The lights follow the two matrices in the buffer.
struct CBPerPass {
    viewMatrix: mat4x4f,
    projectionMatrix: mat4x4f,
}

// Per Pass Constant Buffer for UI Text and UI Sprite
struct CBPerPassUI {
    screenDimension: u32,  // Packed: high 16 bits width, low 16 bits height.
}

// Texture Atlas Properties
struct TextureAtlasProperties {
    tileSizeX: u32,
    tileSizeY: u32,
    padding: u32,
    numTextures: u32,
    numTilesX: u32,
    numTilesY: u32,
    width: u32,
    height: u32,
    paddingType: u32,
}

// Per Sprite Constant Buffer
struct CBPerSprite {
    modelMatrix: mat4x4f,
    color: vec4f,
    atlasIndex: u32,
    flags: u32,
}

// Per Instance Data for the Sprite, UI Sprite and Text Renderers: 96 bytes.
struct InstanceData {
    modelMatrix: mat4x4f,
    color: vec4f,
    atlasIndex: u32,
    flags: u32,
    padding: vec2u,
}

struct VertexIn {
    @location(0) position: vec2f,
    @location(1) uv: vec2f,
}

struct VertexOut {
    @builtin(position) position: vec4f,
    @location(0) uv: vec2f,
    @location(1) color: vec4f,
}

// Common helper functions for WGSL shaders: the counterpart of helpers.hlsl and helpers.metal. Include structs.wgsl first.

// Function to calculate UV coordinates for a texture atlas.
// Atlas index is the index of the texture in the atlas, starting from top left.
// uv will simply be quad UVs from (0,0) to (1,1).
fn GetAtlasUV(uv: vec2f, atlasIndex: u32, atlasProps: TextureAtlasProperties, flags: u32) -> vec2f {
    // pixel sizes
    let tileW = f32(atlasProps.tileSizeX);
    let tileH = f32(atlasProps.tileSizeY);
    let pad = f32(atlasProps.padding);  // padding in pixels

    // cell stride in pixels
    let strideX = tileW + pad;
    let strideY = tileH + pad;

    // tile cell coordinates
    let col = atlasIndex % atlasProps.numTilesX;
    let row = atlasIndex / atlasProps.numTilesX;

    // origin of the tile cell in atlas pixels
    let originX = f32(col) * strideX;
    let originY = f32(row) * strideY;

    // convert normalized uv -> local pixel coordinates inside tile content
    var localPx = uv * vec2f(tileW, tileH);

    // apply horizontal / vertical flip in pixel space
    if ((flags & 1u) != 0u) {
        localPx.x = tileW - localPx.x;
    }
    if ((flags & 2u) != 0u) {
        localPx.y = tileH - localPx.y;
    }

    // map to atlas pixel coords and convert to normalized UV
    let atlasPx = vec2f(originX, originY) + localPx;
    return atlasPx / vec2f(f32(atlasProps.width), f32(atlasProps.height));
}

// Maps a UI position in pixels to clip space. Screen dimensions are packed in a single u32.
fn GetUIPosition(position: vec4f, screenDimension: u32) -> vec4f {
    let screenWidth = f32((screenDimension >> 16u) & 0xFFFFu);
    let screenHeight = f32(screenDimension & 0xFFFFu);
    return vec4f((position.x / screenWidth) * 2.0, (position.y / screenHeight) * 2.0, position.z, position.w);
}


// Bind groups match PSOWebGPU (pso_webgpu.h).
@group(0) @binding(0) var<uniform> passData: CBPerPass;
@group(0) @binding(1) var<uniform> atlasProps: TextureAtlasProperties;
@group(1) @binding(0) var tex: texture_2d<f32>;
@group(1) @binding(1) var texSampler: sampler;
@group(2) @binding(0) var<uniform> spriteData: CBPerSprite;

@vertex
fn VS(input: VertexIn) -> VertexOut {
    var output: VertexOut;

    output.position =
        passData.projectionMatrix * passData.viewMatrix * spriteData.modelMatrix * vec4f(input.position, 0.0, 1.0);
    let flippedUV = vec2f(input.uv.x, 1.0 - input.uv.y);
    output.uv = GetAtlasUV(flippedUV, spriteData.atlasIndex, atlasProps, spriteData.flags);
    output.color = spriteData.color;

    return output;
}

@fragment
fn PS(input: VertexOut) -> @location(0) vec4f {
    let texColor = textureSample(tex, texSampler, input.uv);
    if (texColor.a < 0.1) {
        discard;
    }

    return texColor * input.color;
}
// Simple sprite shader for instanced rendering. WGSL port of sprite_instanced_atlas.hlsl: keep them in sync.

