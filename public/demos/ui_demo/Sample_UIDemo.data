// Per Sprite Constant Buffer
struct CBPerSprite {
    modelMatrix: mat4x4f,
    color: vec4f,
    atlasIndex: u32,
    flags: u32,
}

// Per Instance Data for the Sprite, UI Sprite and Text Renderers: 96 bytes.
struct InstanceData {
    modelMatrix: mat4x4f,
    color: vec4f,
    atlasIndex: u32,
    flags: u32,
    padding: vec2u,
