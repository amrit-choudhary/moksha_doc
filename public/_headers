# Keep search engines on mokshaengine.com, not the project's Cloudflare address.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

# Built assets have a content hash in their names, so they can be cached for good.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Cloudflare doesn't compress application/octet-stream, the default for these packed game files.
# The game loads them as raw bytes, so a type that gets compressed changes nothing else.
/demos/prism_drop/Sample_PrismDrop.data
  Content-Type: text/plain
/demos/tower_climb/Sample_TowerClimb.data
  Content-Type: text/plain
/demos/survivors/Sample_Survivors.data
  Content-Type: text/plain
/demos/evolution/Sample_Evolution.data
  Content-Type: text/plain
/demos/graphics_stress/Sample_GraphicsStress.data
  Content-Type: text/plain
/demos/ui_demo/Sample_UIDemo.data
  Content-Type: text/plain
