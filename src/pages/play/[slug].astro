---
import Base from '../../layouts/Base.astro';
import Player from '../../components/Player.astro';
import { games, type Game } from '../../data/games';

export function getStaticPaths() {
  return games.map((game, index) => ({
    params: { slug: game.slug },
    props: { game, next: games[(index + 1) % games.length] },
  }));
}

interface Props {
  game: Game;
  next: Game;
}

const { game, next } = Astro.props;
const portrait = game.height > game.width;
---

<Base title={game.title} description={game.about}>
  <div class:list={['page', 'game', { portrait }]}>
    <header class="head">
      <p class="eyebrow"><a href="/play/">Play</a> / {game.kind}</p>
      <h1>{game.title}</h1>
    </header>

    <div class="play"><Player game={game} /></div>

    <div class="info">
      <p class="about">{game.about}</p>

      <section>
        <h2>Controls</h2>
        <p class="input-label">{game.inputLabel}</p>
        <dl>
          {game.controls.map((control) => (
            <div>
              <dt>{control.input}</dt>
              <dd>{control.action}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section>
        <h2>What it shows</h2>
        <ul>{game.shows.map((item) => <li>{item}</li>)}</ul>
      </section>

      {game.note && <p class="note">{game.note}</p>}

      <p class="links">
        <a href={game.source}>Source on GitHub</a>
        <a href={`/play/${next.slug}/`}>Next: {next.title}</a>
      </p>
    </div>
  </div>
</Base>

<style>
  .game { display: grid; gap: 28px 56px; padding-top: clamp(24px, 4vw, 48px); }
  .head { grid-column: 1 / -1; }
  h1 { margin-top: 8px; font-size: clamp(2.5rem, 6vw, 4rem); }
  .eyebrow a { color: inherit; }
  .info { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 56px; align-content: start; }
  .about, .note, .links { grid-column: 1 / -1; }
  .about { max-width: 62ch; font-size: 1.125rem; }
  section { min-width: 0; }
  h2 { padding-bottom: 8px; border-bottom: 1px solid var(--rule); font-size: 1.375rem; }
  .input-label { margin-top: 12px; color: var(--muted); font-size: 0.875rem; }
  dl { margin: 8px 0 0; }
  dl div { display: flex; justify-content: space-between; gap: 20px; padding: 7px 0; font-size: 0.9375rem; }
  dd { margin: 0; color: var(--muted); text-align: right; }
  ul { margin: 12px 0 0; padding: 0; list-style: none; font-size: 0.9375rem; }
  li { padding: 4px 0; }
  .note { max-width: 62ch; color: var(--muted); font-size: 0.875rem; }
  .links { display: flex; flex-wrap: wrap; gap: 8px 28px; font-size: 0.9375rem; }

  @media (min-width: 860px) {
    .portrait { grid-template-columns: minmax(0, 450px) minmax(0, 1fr); }
    .portrait .info { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 620px) {
    .info { grid-template-columns: minmax(0, 1fr); }
  }
</style>
