---
import Base from '../../layouts/Base.astro';
import GameList from '../../components/GameList.astro';
---

<Base title="Play the demos" description="Play the Moksha engine's sample games in your browser. They run as WebAssembly and draw with WebGPU.">
  <div class="page">
    <header class="intro">
      <h1>Play</h1>
      <p>Small games and tests built on Moksha, running as WebAssembly and drawn with WebGPU. Your browser needs WebGPU. A game downloads only when you press play.</p>
    </header>
    <GameList />
  </div>
</Base>

<style>
  .intro { padding: clamp(40px, 8vw, 88px) 0 clamp(32px, 5vw, 56px); }
  h1 { font-size: clamp(2.75rem, 7vw, 4.5rem); }
  p { max-width: 58ch; margin-top: 18px; color: var(--muted); font-size: 1.0625rem; }
</style>
