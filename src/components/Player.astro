---
import type { Game } from '../data/games';

interface Props {
  game: Game;
}

const { game } = Astro.props;
---

<moksha-player
  class="player"
  data-title={game.title}
  data-src={`/demos/${game.folder}/`}
  data-width={game.width}
  data-height={game.height}
>
  <div class="stage" style={`aspect-ratio: ${game.width} / ${game.height}; max-width: ${game.width}px`}>
    <div class="cover" style={`--poster: url(/images/games/${game.slug}.jpg)`}>
      <button class="button start" type="button" aria-label={`Start ${game.title}`}>Start</button>
      <p class="cover-note" data-role="note"></p>
      {game.needsKeyboard && <p class="cover-note touch-only">This game needs a physical keyboard.</p>}
      <noscript><p class="cover-note">Playing needs JavaScript.</p></noscript>
    </div>
  </div>
  <div class="player-bar" hidden>
    <span class="focus-hint" data-role="hint" hidden>Click the game to use the keyboard.</span>
    <button class="quiet-button" type="button" data-role="restart">Restart</button>
  </div>
</moksha-player>

<style>
  .player { display: block; width: 100%; }
  .stage {
    position: relative;
    width: 100%;
    margin: 0 auto;
    overflow: hidden;
    background: var(--surface);
    outline: 1px solid var(--rule);
  }
  .stage :global(iframe) { display: block; width: 100%; height: 100%; border: 0; }
  .cover {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 24px;
    text-align: center;
    background: linear-gradient(rgb(5 5 5 / 0.72), rgb(5 5 5 / 0.72)), var(--poster) center / cover;
  }
  .cover-note { max-width: 34ch; color: var(--text); font-size: 0.875rem; }
  .cover-note:empty { display: none; }
  .touch-only { display: none; }
  @media (hover: none) and (pointer: coarse) {
    .touch-only { display: block; }
  }
  .player-bar {
    display: flex;
    justify-content: flex-end;
    gap: 20px;
    margin: 10px auto 0;
    font-size: 0.875rem;
  }
  .player-bar[hidden], .focus-hint[hidden] { display: none; }
  .focus-hint { margin-right: auto; color: var(--muted); }
</style>

<script>
  const UNSUPPORTED =
    'This browser doesn’t offer WebGPU here, so the game can’t run. Try the current version of Chrome or Safari on a desktop.';

  class MokshaPlayer extends HTMLElement {
    stage!: HTMLElement;
    bar!: HTMLElement;
    hint!: HTMLElement;
    restart!: HTMLButtonElement;
    frame: HTMLIFrameElement | null = null;
    size = { width: 0, height: 0 };

    connectedCallback() {
      this.stage = this.querySelector('.stage')!;
      this.bar = this.querySelector('.player-bar')!;
      this.hint = this.querySelector('[data-role="hint"]')!;
      this.restart = this.querySelector('[data-role="restart"]')!;

      this.applySize();
      window.addEventListener('resize', () => this.onResize());
      // Safari can run this before the stylesheet arrives, when this element has no width yet, so size it again once it does.
      new ResizeObserver(() => this.onResize()).observe(this);
      window.addEventListener('focus', () => this.updateHint());
      window.addEventListener('blur', () => setTimeout(() => this.updateHint(), 0));
      document.addEventListener('pointerdown', () => setTimeout(() => this.updateHint(), 0));

      this.querySelector<HTMLButtonElement>('.start')!.addEventListener('click', () => this.start());
      this.restart.addEventListener('click', () => this.start());

      this.checkWebGPU();
    }

    // The game reads its frame's size once at startup, shrinks to fit and never upscales.
    measure() {
      const width = Number(this.dataset.width);
      const height = Number(this.dataset.height);
      const availableWidth = this.clientWidth;
      const availableHeight = Math.max(240, window.innerHeight - 72);
      const scale = Math.min(1, availableWidth / width, availableHeight / height);
      return { width: Math.floor(width * scale), height: Math.floor(height * scale) };
    }

    applySize() {
      const size = this.measure();
      if (!size.width) return;
      this.size = size;
      this.stage.style.width = `${this.size.width}px`;
      this.stage.style.height = `${this.size.height}px`;
      this.bar.style.width = `${this.size.width}px`;
    }

    onResize() {
      if (!this.frame) {
        this.applySize();
        return;
      }
      const next = this.measure();
      if (next.width !== this.size.width || next.height !== this.size.height) {
        this.restart.textContent = 'Restart to fit';
      }
    }

    start() {
      this.frame?.remove();
      this.querySelector('.cover')?.remove();
      this.applySize();
      this.restart.textContent = 'Restart';

      const frame = document.createElement('iframe');
      frame.title = this.dataset.title!;
      frame.src = this.dataset.src!;
      frame.addEventListener('load', () => {
        frame.contentWindow?.focus();
        this.updateHint();
      });
      this.frame = frame;
      this.stage.append(frame);
      this.bar.hidden = false;
      frame.focus();
      this.scrollIntoView({ block: 'nearest' });
      this.updateHint();
    }

    updateHint() {
      this.hint.hidden = !this.frame || document.activeElement === this.frame;
    }

    async checkWebGPU() {
      let supported = false;
      try {
        const gpu = (navigator as Navigator & { gpu?: { requestAdapter(): Promise<unknown> } }).gpu;
        supported = !!gpu && !!(await gpu.requestAdapter());
      } catch {
        supported = false;
      }
      if (supported || this.frame) return;
      this.querySelector('.start')?.remove();
      const note = this.querySelector('[data-role="note"]');
      if (note) note.textContent = UNSUPPORTED;
    }
  }

  customElements.define('moksha-player', MokshaPlayer);
</script>
