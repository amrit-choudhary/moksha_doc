---
import { getCollection } from 'astro:content';
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  current?: string;
}

const { title, description, current } = Astro.props;
const pages = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const index = pages.findIndex((page) => page.id === current);
const next = index >= 0 ? pages[index + 1] : pages[0];
---

<Base title={title} description={description}>
  <div class="page docs">
    <nav class="sidebar" aria-label="Documentation">
      <a href="/docs/" aria-current={current ? undefined : 'page'}>Overview</a>
      {pages.map((page) => (
        <a href={`/docs/${page.id}/`} aria-current={page.id === current ? 'page' : undefined}>{page.data.title}</a>
      ))}
    </nav>
    <article class="prose">
      <h1>{title}</h1>
      <p class="description">{description}</p>
      <slot />
      {next && <p class="next"><a href={`/docs/${next.id}/`}>Next: {next.data.title}</a></p>}
    </article>
  </div>
</Base>

<style>
  .docs { display: grid; grid-template-columns: 13rem minmax(0, 1fr); gap: clamp(32px, 6vw, 80px); padding-top: clamp(24px, 4vw, 48px); }
  .sidebar { position: sticky; top: 24px; align-self: start; display: flex; flex-direction: column; gap: 2px; font-size: 0.9375rem; }
  .sidebar a { padding: 5px 0; color: var(--muted); text-decoration: none; }
  .sidebar a:hover { color: var(--text); }
  .sidebar a[aria-current] { color: var(--accent); }
  h1 { font-size: clamp(2.5rem, 5vw, 3.75rem); }
  .description { margin: 16px 0 2.25em; color: var(--muted); font-size: 1.125rem; }
  .next { margin-top: 3.5em; padding-top: 18px; border-top: 1px solid var(--rule); }

  @media (max-width: 820px) {
    .docs { grid-template-columns: minmax(0, 1fr); }
    .sidebar { position: static; flex-direction: row; flex-wrap: wrap; gap: 2px 16px; padding-bottom: 16px; border-bottom: 1px solid var(--rule); }
  }
</style>
