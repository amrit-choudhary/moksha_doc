---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { ENGINE_REPO } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description = 'A handcrafted, open source C++ game engine with multiplayer and no dependencies to install, built for AI to create games with. Play the demos in your browser.',
  noindex = false,
  structuredData,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL('/images/og.jpg', Astro.site);
const pageTitle = title ? `${title} · Moksha game engine` : 'Moksha: a handcrafted C++ game engine';
const path = Astro.url.pathname;
const section = path.startsWith('/docs') ? 'docs' : path.startsWith('/play') ? 'play' : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#050505" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Moksha" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A handcrafted C++ game engine, beside a spiral galaxy drawn by one of its demos." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/">moksha</a>
      <nav aria-label="Main">
        <a href="/docs/" aria-current={section === 'docs' ? 'page' : undefined}>Docs</a>
        <a href="/play/" aria-current={section === 'play' ? 'page' : undefined}>Play</a>
        <a href={ENGINE_REPO}>GitHub</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <span>Moksha, by Amrit Choudhary. MIT licence.</span>
      <span><a href={ENGINE_REPO}>Engine</a> <a href="https://github.com/amrit-choudhary/moksha_samples">Samples</a></span>
    </footer>
  </body>
</html>
